  <default><geom friction="0.6 0.005 0.0001"/></default>
  <worldbody>
    <light pos="0 -1 2" dir="0 0 -1"/>
    <camera name="overview" pos="0.9 -1.2 0.9" xyaxes="0.8 0.6 0 -0.3 0.4 0.866"/>
    <geom name="floor" type="plane" size="1 1 0.1" rgba="0.07 0.09 0.07 1"/>
    <body name="cube" pos="0.12 0.05 0.6">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" mass="0.05" rgba="0.65 1 0.05 1"/>
    </body>
    <body name="arm" pos="-0.35 0 0.08">
      <joint name="pan" type="hinge" axis="0 0 1" range="-1.5 1.5" damping="1"/>
      <geom name="arm_geom" type="capsule" fromto="0 0 0 0.20 0 0" size="0.018" mass="0.20" rgba="0.45 0.65 0.42 1"/>
      <site name="tip" pos="0.20 0 0" size="0.025" rgba="1 0.7 0.2 1"/>
    </body>
  </worldbody>
  <actuator><position name="pan_target" joint="pan" kp="25" ctrlrange="-1.5 1.5"/></actuator>
</mujoco>
